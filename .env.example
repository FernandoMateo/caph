# URL de PocketBase vista desde el servidor de Next.js (misma máquina; en el VPS es el puerto 8091).
# En producción Caddy manda /api directo a PocketBase; en local la web le reenvía /api y /_/ (next.config.mjs).
PB_URL=http://127.0.0.1:8090

# Opcional: clave pública de Cloudflare Turnstile para el desafío anti-robots de /alta (se usa al compilar).
# La clave secreta va en el servidor de PocketBase como TURNSTILE_SECRET (/opt/caph/pocketbase/.env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
